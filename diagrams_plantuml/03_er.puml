@startuml
' Figure 8.3 - Entity-Relationship Diagram
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
hide circle
hide methods

entity INVESTIGATORS {
  * id : PK
  --
  * email : VARCHAR (UQ)
  * password_hash : VARCHAR
  * role : ENUM
}

entity CASES {
  * id : PK
  --
  * case_number : VARCHAR (UQ)
  * title : VARCHAR
  * status : ENUM
  * created_by_id : FK
}

entity EVIDENCE_ITEMS {
  * id : PK
  --
  * case_id : FK
  * evidence_number : VARCHAR (UQ)
  * original_hash : CHAR(64)
  * lifecycle_state : ENUM
  * uploaded_by_id : FK
}

entity CUSTODY_LOGS {
  * id : PK
  --
  * evidence_id : FK
  * event_type : ENUM
  * timestamp : DATETIME
  * digital_signature : TEXT
}

entity AUDIT_RECORDS {
  * id : PK
  --
  investigator_id : FK
  evidence_id : FK
  * result : ENUM
  * timestamp : DATETIME
}

entity CASE_ACCESS {
  * id : PK
  --
  * case_id : FK
  * investigator_id : FK
  * permission : ENUM
}

INVESTIGATORS ||--o{ CASES
INVESTIGATORS ||--o{ EVIDENCE_ITEMS
INVESTIGATORS ||--o{ AUDIT_RECORDS
INVESTIGATORS ||--o{ CASE_ACCESS
CASES         ||--o{ EVIDENCE_ITEMS
CASES         ||--o{ CASE_ACCESS
EVIDENCE_ITEMS ||--|{ CUSTODY_LOGS
EVIDENCE_ITEMS ||--o{ AUDIT_RECORDS
@enduml
