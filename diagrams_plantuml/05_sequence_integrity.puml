@startuml
' Figure 8.5 - Sequence Diagram: Chain-of-Custody Integrity Verification
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequenceMessageAlign first
autonumber "<b>[00]"

actor Analyst as A
boundary "custody\nblueprint" as R
control "GraphIntegrity\nEngine" as E
entity "EvidenceItem\n: Model" as EV
entity "CustodyLog\n: Model" as CL
database "Database" as DB
collections "Encrypted\nFile Store" as FS
control "crypto\n(hashlib, Ed25519)" as C

A -> R : GET /evidence/{id}/verify
activate R

R -> R : check case membership
note right: fails closed —\nno access, no verification

R -> E : new GraphIntegrityEngine(evidence)
activate E
R -> E : verify()

E -> DB : SELECT evidence WHERE id = ?
DB --> EV : row
EV --> E : evidence
E -> DB : SELECT custody_logs ORDER BY timestamp
DB --> CL : rows
CL --> E : List<CustodyLog>

E -> E : buildGraph()
note right: nodes = events\nedges = successor links\nroot = the Upload event

E -> FS : read(evidence.file_path)
activate FS
FS --> E : ciphertext
deactivate FS
E -> C : decrypt() then sha256()
activate C
C --> E : groundTruthHash
deactivate C

loop for each node in depth-first traversal
    E -> E : checkHash(node)
    E -> C : verify(payload, signature, publicKey)
    activate C
    C --> E : valid / invalid
    deactivate C
    E -> E : checkTimestamp(node)

    alt any check failed
        E -> E : failures.append(NodeFailure)
        note right: <b>continue</b> the traversal —\ndo not short-circuit
    else all three passed
        E -> E : verified += 1
    end
end

E -> E : completeness = verified / total
E -> E : verdict = Intact | Partially Verified | Broken

E -> DB : UPDATE evidence SET integrity_status = ?
note right: closes the loop to the\nrisk scorer (finding D2)

E --> R : IntegrityReport
deactivate E

R -> DB : INSERT audit_record
R --> A : verdict, completeness %, failure table
deactivate R

opt verdict = Broken
    A -> R : POST /evidence/{id}/change-state → Flagged
end
@enduml
