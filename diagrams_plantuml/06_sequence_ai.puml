@startuml
' Figure 8.6 - Sequence Diagram: AI Assistant Orchestration Workflow
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam backgroundColor white
autonumber "<b>[00]"

actor Investigator as U
boundary "Chat UI" as UI
boundary "assistant\nblueprint" as R
control "AIInvestigation\nAssistant" as A
entity "CaseAccess" as CA
database "Database" as DB
participant "NVIDIA NIM\n(hosted LLM)" as LLM <<external service>>

U -> UI : types a question
UI -> R : POST /assistant/chat  {message}
activate R
R -> A : answer(message, history, user)
activate A

group Stage 1 — Intent classification
    A -> A : classify_intent(message)
    note right: 7 intents + UNKNOWN;\nthe identity intent is\nchecked with priority
end

group Stage 2 — Access-scoped retrieval
    A -> CA : accessible_case_ids(user)
    activate CA
    CA --> A : [caseIds] or ALL
    deactivate CA
    A -> DB : SELECT ... WHERE case_id IN (:caseIds)
    DB --> A : permitted records only
    note right: the scoping happens <b>here</b>,\nso no later stage can leak
end

group Stage 3 — Prompt construction
    A -> A : build_prompt(msg, context, user)
    note right: system prompt + context block\n+ caller identity + trimmed history
end

group Stage 4 — Model invocation
    loop for each candidate model, within the total budget
        A -> LLM : POST /chat/completions
        activate LLM
        alt 200 OK
            LLM --> A : reply
            deactivate LLM
        else 410 Gone (model retired) or timeout
            LLM --> A : error
            note right: try the next candidate
        end
    end
    alt all candidates failed, or no API key
        A -> A : context-aware mock reply
    end
end

group Stage 5 — Response validation
    A -> A : strip_reasoning(raw)
    A -> A : validate_response(reply, intent)
    note right: minimum length, refusal\npatterns, off-topic drift
end

group Stage 6 — Hallucination detection
    A -> A : check_hallucinations(reply, context, user, question)
    note right: every case number, evidence id and\ninvestigator name is cross-checked\nagainst the retrieved context
end

A --> R : AssistantResponse
deactivate A
R --> UI : {reply, intent, contextUsed, flags}
deactivate R
UI -> U : renders the answer

opt flags is non-empty
    UI -> U : displays an explicit hallucination warning
end
@enduml
