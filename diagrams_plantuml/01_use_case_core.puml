@startuml
' Figure 8.1 - Use Case Diagram (a): Authentication, Cases, Evidence, Custody
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam packageStyle rectangle
left to right direction
skinparam nodesep 12
skinparam ranksep 40

actor "Read-Only\nAuditor" as RO
actor "Analyst" as ANA
actor "Lead\nInvestigator" as LEAD
actor "Administrator" as ADM

ANA  -up-|> RO
LEAD -up-|> ANA
ADM  -up-|> LEAD

rectangle "DEICMS — Core Evidence Workflow" {

  package "1. Authentication & Session" {
    usecase "UC-01\nLog in" as U01
    usecase "UC-02\nVerify one-time password" as U02
    usecase "UC-03\nLog out" as U03
    usecase "UC-04\nEnrol two-factor auth" as U04
    usecase "UC-05\nDisable two-factor auth" as U05
  }

  package "2. Dashboard & Cases" {
    usecase "UC-06\nView role-tailored dashboard" as U06
    usecase "UC-07\nList accessible cases" as U07
    usecase "UC-09\nView a case" as U09
    usecase "UC-08\nCreate a case" as U08
    usecase "UC-10\nEdit case metadata" as U10
    usecase "UC-12\nGrant case access" as U12
    usecase "UC-13\nRevoke case access" as U13
    usecase "UC-11\nArchive a case" as U11
  }

  package "3. Evidence Management" {
    usecase "UC-15\nView an evidence item" as U15
    usecase "UC-14\nUpload and register evidence" as U14
    usecase "UC-16\nEdit evidence metadata" as U16
    usecase "UC-17\nSoft-delete an evidence item" as U17
  }

  package "4. Custody & Integrity" {
    usecase "UC-19\nView custody log" as U19
    usecase "UC-20\nVerify chain integrity" as U20
    usecase "UC-21\nVerification result as JSON" as U21
    usecase "UC-22\nReconstruct custody chain" as U22
    usecase "UC-18\nTransfer custody" as U18
    usecase "UC-23\nChange lifecycle state" as U23
  }
}

' Read-Only Auditor - the base capability set
RO --> U01
RO --> U03
RO --> U04
RO --> U05
RO --> U06
RO --> U07
RO --> U09
RO --> U15
RO --> U19
RO --> U20
RO --> U21
RO --> U22

' Analyst adds custody participation
ANA --> U18
ANA --> U23

' Lead Investigator adds case and evidence management
LEAD --> U08
LEAD --> U10
LEAD --> U12
LEAD --> U13
LEAD --> U14
LEAD --> U16

' Administrator adds the destructive operations
ADM --> U11
ADM --> U17

U02 ..> U01 : <<extend>>
U14 ..> U01 : <<include>>
U18 ..> U01 : <<include>>
U20 ..> U01 : <<include>>
U22 ..> U20 : <<extend>>
U23 ..> U20 : <<extend>>

note right of ADM
  Actor generalisation: each role
  inherits every use case of the
  role below it, and the arrows
  show only what it <b>adds</b>.
  Admin (41) > Lead (28)
  > Analyst (24) > Read-Only (23).
end note
@enduml
