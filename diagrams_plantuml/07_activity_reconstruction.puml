@startuml
' Figure 8.7 - Activity Diagram: Chain Reconstruction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white

start
:Load confirmed
custody records;

if (any gaps?) then (no)
  :Confidence = 100%;
  stop
else (yes)
endif

repeat
  :Take next gap;
  :Find candidate records
  in the time window;
  :Score each candidate
  on 4 criteria;

  if (best score >= 0.40?) then (yes)
    :Label INFERRED
    with reasoning;
  else (no)
    :Label UNRESOLVED;
  endif
repeat while (more gaps?) is (yes) not (no)

:Compute overall confidence;
:Return timeline
(Confirmed / Inferred / Unresolved);
stop
@enduml
