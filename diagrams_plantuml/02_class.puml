@startuml
' Figure 8.2 - Class Diagram
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam classAttributeIconSize 0
hide circle

class Investigator {
  - email
  - password_hash
  - role
  - public_key
  --
  + check_password()
  + can_manage()
}

class Case {
  - case_number
  - title
  - status
  --
  + archive()
}

class EvidenceItem {
  - evidence_number
  - original_hash
  - lifecycle_state
  - risk_score
  --
  + verify_integrity()
  + compute_risk()
}

class CustodyLog {
  - event_type
  - timestamp
  - digital_signature
  --
  + verify_signature()
}

class AuditRecord {
  - event_type
  - timestamp
  - result
  --
  + record()
}

class CaseAccess {
  - permission
  --
  + accessible_cases()
}

Case "1" *-- "0..*" EvidenceItem : contains
EvidenceItem "1" *-- "1..*" CustodyLog : logs
Investigator "1" -- "0..*" Case : creates
Investigator "1" -- "0..*" EvidenceItem : holds
Investigator "1" -- "0..*" CustodyLog : transfers
Investigator "1" -- "0..*" AuditRecord : performs
Case "1" -- "0..*" CaseAccess : grants
Investigator "1" -- "0..*" CaseAccess : receives
@enduml
