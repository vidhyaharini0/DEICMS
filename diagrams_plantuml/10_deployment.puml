@startuml
' Figure 8.10 - Deployment Diagram
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white

node "Client" {
  artifact "Web Browser" as BROWSER
}

node "Application Host" {
  artifact "Werkzeug Server (HTTPS)" as WSGI
  artifact "Flask Application" as APP
  database "deicms.db (SQLite)" as DB
  folder "uploads/ (AES-256-GCM)" as FS
}

cloud "NVIDIA NIM" {
  artifact "Hosted LLM" as LLM
}

BROWSER --> WSGI : HTTPS
WSGI --> APP
APP --> DB : SQL
APP --> FS : encrypted I/O
APP --> LLM : HTTPS REST
@enduml
