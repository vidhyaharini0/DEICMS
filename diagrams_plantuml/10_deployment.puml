@startuml
' Figure 7.12 - Deployment Diagram: DEICMS Development Environment
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white

node "Client Workstation" as CLIENT {
  artifact "Web Browser" as BROWSER
}

node "Application Host" as HOST {
  node "Python 3 Runtime" as PY {
    artifact "Flask Application\n(application factory,\n10 blueprints)" as APP
    artifact "SQLAlchemy ORM" as ORM
    artifact "Werkzeug HTTPS Server\n(self-signed TLS)" as WSGI
  }
  database "deicms.db\n(SQLite, WAL mode)" as DB
  folder "uploads/\n(AES-256-GCM\nencrypted files)" as UP
  artifact ".env\n(secrets)" as ENV
}

cloud "NVIDIA NIM\nInference Service" as NIM {
  artifact "Hosted LLM" as MODEL
}

BROWSER -down-> WSGI : HTTPS :5000
WSGI -down-> APP
APP -down-> ORM
ORM -down-> DB : SQL
APP -down-> UP : encrypted read/write
APP -left-> ENV : loads at startup
APP -right-> MODEL : HTTPS REST\n(OpenAI-compatible)

note bottom of HOST
  Production path: replace SQLite with
  PostgreSQL and Werkzeug with
  gunicorn behind a reverse proxy.
  No application code changes required.
end note
@enduml
