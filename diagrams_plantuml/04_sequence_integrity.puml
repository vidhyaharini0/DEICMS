@startuml
' Figure 8.4 - Sequence Diagram: Integrity Verification
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white

actor Analyst
participant "Route" as R
participant "Integrity\nEngine" as E
database "Database" as DB
participant "File Store" as FS

Analyst -> R : verify(evidence)
activate R
R -> R : check case access
R -> E : verify()
activate E

E -> DB : load evidence + custody logs
DB --> E : records
E -> E : build graph
E -> FS : read file
FS --> E : bytes
E -> E : compute SHA-256

loop each node
  E -> E : check hash
  E -> E : check signature
  E -> E : check timestamp
  E -> E : collect failure (continue)
end

E -> E : verdict + completeness
E -> DB : save integrity_status
E --> R : IntegrityReport
deactivate E
R --> Analyst : verdict + failures
deactivate R
@enduml
