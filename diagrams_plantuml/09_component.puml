@startuml
' Figure 8.9 - Component Diagram
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam componentStyle uml2

package "Presentation" {
  [Templates]
}

package "Routing (10 blueprints)" {
  [auth]
  [cases / evidence]
  [custody]
  [risk]
  [assistant]
  [admin]
}

package "Business Logic" {
  [graph_integrity]
  [risk_scoring]
  [chain_reconstruction]
  [state_machine]
  [ai_assistant]
  [crypto]
}

package "Data Access" {
  [Models]
  [SQLAlchemy ORM]
}

database "Database" as DB
folder "Encrypted Files" as FS
cloud "NVIDIA NIM" as NIM

[Templates] ..> [cases / evidence]
[custody] ..> [graph_integrity]
[custody] ..> [state_machine]
[custody] ..> [chain_reconstruction]
[risk] ..> [risk_scoring]
[assistant] ..> [ai_assistant]
[auth] ..> [crypto]

[graph_integrity] ..> [crypto]
[graph_integrity] ..> [Models]
[risk_scoring] ..> [Models]
[state_machine] ..> [Models]
[ai_assistant] ..> [Models]
[ai_assistant] --> NIM

[Models] ..> [SQLAlchemy ORM]
[SQLAlchemy ORM] --> DB
[crypto] --> FS
@enduml
