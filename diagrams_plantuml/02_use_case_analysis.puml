@startuml
' Figure 8.2 - Use Case Diagram (b): Analysis, Reporting, Assistant, Administration
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam packageStyle rectangle
left to right direction
skinparam nodesep 12
skinparam ranksep 40

actor "Read-Only\nAuditor" as RO
actor "Analyst" as ANA
actor "Lead\nInvestigator" as LEAD
actor "Administrator" as ADM

ANA  -up-|> RO
LEAD -up-|> ANA
ADM  -up-|> LEAD

usecase "UC-20\nVerify chain integrity\n(see Figure 8.1)" as U20

rectangle "DEICMS — Analysis, Reporting & Administration" {

  package "5. Analysis & Reporting" {
    usecase "UC-24\nView risk dashboard" as U24
    usecase "UC-25\nView per-item risk report" as U25
    usecase "UC-26\nRisk report as JSON" as U26
    usecase "UC-27\nView anomaly dashboard" as U27
    usecase "UC-29\nView item audit trail" as U29
    usecase "UC-30\nRun formula checks" as U30
    usecase "UC-32\nDownload PDF custody report" as U32
    usecase "UC-31\nExport signed case package" as U31
    usecase "UC-28\nView global audit trail" as U28
  }

  package "6. AI Investigation Assistant" {
    usecase "UC-33\nOpen assistant chat" as U33
    usecase "UC-34\nAsk the assistant" as U34
    usecase "UC-35\nClear conversation history" as U35
  }

  package "7. Administration" {
    usecase "UC-36\nList investigator accounts" as U36
    usecase "UC-37\nCreate investigator account" as U37
    usecase "UC-38\nChange account role" as U38
    usecase "UC-39\nActivate / deactivate account" as U39
    usecase "UC-40\nUnlock a locked account" as U40
    usecase "UC-41\nConfigure risk weights" as U41
  }
}

' Read-Only Auditor - the base capability set
RO --> U24
RO --> U25
RO --> U26
RO --> U27
RO --> U29
RO --> U30
RO --> U32
RO --> U33
RO --> U34
RO --> U35

' Analyst adds nothing in this area

' Lead Investigator adds export
LEAD --> U31

' Administrator adds oversight and account management
ADM --> U28
ADM --> U36
ADM --> U37
ADM --> U38
ADM --> U39
ADM --> U40
ADM --> U41

U31 ..> U20 : <<include>>
U32 ..> U20 : <<include>>
U34 ..> U33 : <<include>>

note right of ADM
  <b>Actor generalisation</b> — each actor is joined
  only to what it <b>adds</b> (see Figure 8.1).

  The Analyst adds nothing in this area: analysis
  and reporting are <b>read</b> activities available to
  every role within its accessible cases. The
  Analyst's two extra use cases are both custody
  actions, in Figure 8.1.

  Seven of the nine <b>Admin-exclusive</b> use cases
  are here: UC-28 and UC-36 to UC-41.
end note
@enduml
