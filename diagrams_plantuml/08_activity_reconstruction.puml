@startuml
' Figure 8.8 - Activity Diagram: Custody Chain Reconstruction (heuristic search)
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam backgroundColor white

|#white|Analyst|
start
:Request reconstruction
for an evidence item;

|Reconstruction Engine|
:Load confirmed custody records
in timestamp order;

if (chain empty?) then ([yes])
  |Presentation|
  :confidence := 0.0;
  :Report "no custody history";
  stop
else ([no])
endif

|Reconstruction Engine|
partition "Gap detection" {
  repeat
    :Take the next consecutive pair (r1, r2);
    if (holder of r1 ≠ sender of r2?) then ([structural gap])
      :Record a gap;
    elseif (hours between > 72?) then ([temporal gap])
      :Record a gap;
    else ([contiguous])
      :Label the link CONFIRMED;
    endif
  repeat while (more pairs?) is ([yes]) not ([no])
}

if (any gap detected?) then ([no])
  |Presentation|
  :confidence := 1.0;
  :Return a fully CONFIRMED chain;
  stop
else ([yes])
endif

partition "Best-first search over each gap" {
  repeat
    |Reconstruction Engine|
    :Take the next gap;
    :Query the access log for events
    inside the gap's time window;

    if (any candidates?) then ([no])
      :Label the gap UNRESOLVED;
    else ([yes])
      repeat
        :Score the next candidate on
        four independent criteria;
        note right
          temporal proximity
          role consistency
          location consistency
          behavioural consistency
        end note
      repeat while (more candidates?) is ([yes]) not ([no])

      :best := argmax(score);

      if (best.score ≥ 0.40?) then ([yes])
        :Insert an INFERRED link;
        :Attach its confidence and
        the four sub-scores as reasoning;
      else ([no])
        :Label the gap UNRESOLVED;
        note right
          <b>The algorithm refuses to guess.</b>
          Three separate paths end here.
        end note
      endif
    endif
  repeat while (more gaps?) is ([yes]) not ([no])
}

:confidence := (confirmed + inferred) / total links;

|Presentation|
:Return the timeline with every link
labelled CONFIRMED / INFERRED / UNRESOLVED;
note right
  An inferred link is never
  displayed as confirmed (DR-07).
end note
stop
@enduml
