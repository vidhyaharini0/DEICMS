@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor white
title CARD 3 - Sequence: arrows and fragments

participant "Caller" as A
participant "Service" as B
participant "Store" as C

A -> B : 1. synchronous call\n(SOLID line, FILLED head - caller waits)
activate B
note right of B : the thin rectangle\nis the ACTIVATION BAR
B -> C : 2. another call
activate C
C --> B : 3. return\n(DASHED line, open head)
deactivate C

loop for every node
  B -> B : 4. self-call
  alt check failed
    B -> B : 5. record failure
  else passed
    B -> B : 6. count verified
  end
end

B --> A : 7. result
deactivate B

note over A, C
  TIME FLOWS DOWNWARD.  Lifelines are DASHED vertical lines.
  Fragments:  loop   alt (alternative)   opt (optional)   par (parallel)
end note
@enduml
