@startuml
' Figure - Component Diagram: components and their interfaces
!include _header.txt

component "Web Interface" as WEB
component "Authentication" as AUTH
component "Case Management" as CASES
component "Evidence Management" as EVID
component "Custody and Integrity" as CUST
component "Risk Assessment" as RISK
component "Investigation Assistant" as AI
component "Audit and Export" as AUD
component "Access Control" as AC
database "Evidence Store" as FS
database "Relational Store" as DB
