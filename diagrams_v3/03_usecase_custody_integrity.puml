@startuml
' Figure - Use Case Diagram: custody, integrity and assessment
!include _header.txt
left to right direction

actor "Read-Only Auditor" as RO
actor "Forensic Analyst"  as ANA
actor "Lead Investigator" as LEAD
ANA --|> RO
LEAD --|> ANA

rectangle "Custody, Integrity and Assessment" {
  usecase "View custody log"          as UC20
  usecase "Verify chain integrity"    as UC21
  usecase "Read verification as data" as UC22
  usecase "Reconstruct custody chain" as UC23
  usecase "View risk ranking"         as UC24
  usecase "View item risk report"     as UC25
  usecase "Read risk as data"         as UC26
  usecase "View anomaly report"       as UC27
  usecase "Ask the assistant"         as UC28
  usecase "Clear conversation"        as UC29
  usecase "View audit trail"          as UC30
  usecase "View item audit trail"     as UC31
  usecase "Run formula checks"        as UC32
  usecase "Record custody transfer"   as UC33
  usecase "Change lifecycle state"    as UC34
  usecase "Export signed case"        as UC35
  usecase "Generate custody report"   as UC36
  usecase "Re-assess risk"            as UC37
  usecase "Locate every failure"      as UC38
}

RO   --> UC20
RO   --> UC21
RO   --> UC22
RO   --> UC23
RO   --> UC24
RO   --> UC25
RO   --> UC26
RO   --> UC27
RO   --> UC28
RO   --> UC29
RO   --> UC30
RO   --> UC31
RO   --> UC32
ANA  --> UC33
ANA  --> UC34
LEAD --> UC35
LEAD --> UC36

UC21 ..> UC38 : <<include>>
UC34 ..> UC37 : <<include>>
UC35 ..> UC21 : <<include>>
UC23 .> UC21  : <<extend>>

note bottom of UC23
  Reconstruction EXTENDS verification:
  it is optional behaviour invoked only
  when the verified chain proves incomplete.
end note
@enduml
