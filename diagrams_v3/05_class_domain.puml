@startuml
' Figure - Class Diagram: domain model with behaviour
!include _header.txt
hide empty members

class Investigator {
  - passwordHash : String
  - privateKeyEncrypted : String
  + fullName : String
  + role : Role
  + publicKey : String
  + isAdmin() : Boolean
  + canManage() : Boolean
  + canAnalyse() : Boolean
  + setPassword(plain) : void
  + checkPassword(plain) : Boolean
  + isLocked() : Boolean
  + recordFailedLogin(max, minutes) : void
  + resetLoginAttempts() : void
  + is2faEnabled() : Boolean
}

class Case {
  + caseNumber : String
  + title : String
  + status : CaseStatus
  + isArchived : Boolean
}

class EvidenceItem {
  + evidenceNumber : String
  + originalHash : Digest
  + currentHash : Digest
  + lifecycleState : LifecycleState
  + integrityStatus : IntegrityStatus
  + isDeleted : Boolean
}

class CustodyLog {
  + eventType : EventType
  + timestamp : DateTime
  + fileHashAtEvent : Digest
  + digitalSignature : Signature
}

class AuditRecord {
  + eventType : String
  + description : String
  + timestamp : DateTime
  .. insert-only ..
}

class CaseAccess {
  + permission : Permission
  + {static} canAccess(caseId, user) : Boolean
  + {static} accessibleCaseIds(user) : List
  + {static} grant(caseId, userId, perm) : CaseAccess
}

enum Role {
  Admin
  LeadInvestigator
  Analyst
  ReadOnly
}

enum LifecycleState {
  Collected
  Submitted
  UnderAnalysis
  Transferred
  Archived
  Flagged
}

class GraphIntegrityEngine <<engine>> {
  - evidence : EvidenceItem
  + verify() : IntegrityReport
  - buildDag(logs) : List
  - dfs(node, predecessorTime) : void
  - checkHash(node) : Boolean
  - checkSignature(node) : Boolean
  - checkTimestamp(node, prev) : Boolean
}

class EvidenceRiskScorer <<engine>> {
  + score(evidence) : RiskReport
  - extractAndNormalise(ev, logs) : List
  - classify(score) : RiskLevel
}

class EvidenceStateMachine <<engine>> {
  - {static} TRANSITION_TABLE : Map
  + transitionTo(target, reason) : TransitionResult
  - recalculateRiskScore() : void
}

class CryptoService <<service>> {
  + {static} signPayload(privateKey, payload) : Signature
  + {static} verifySignature(publicKey, payload, sig) : Boolean
  + {static} generateEncryptedKeyPair() : Pair
}

class IntegrityReport <<value>> {
  + verdict : Verdict
  + completeness : Percent
  + failures : List
}

Case "1" *-- "0..*" EvidenceItem : contains >
EvidenceItem "1" *-- "1..*" CustodyLog : is traced by >
Investigator "1" -- "0..*" CustodyLog : creates >
Investigator "1" -- "0..*" AuditRecord : causes >
Case "1" -- "0..*" CaseAccess : is shared through >
Investigator "1" -- "0..*" CaseAccess : is granted >
Investigator --> Role
EvidenceItem --> LifecycleState

GraphIntegrityEngine ..> EvidenceItem : <<use>>
GraphIntegrityEngine ..> CustodyLog : <<use>>
GraphIntegrityEngine ..> IntegrityReport : <<create>>
GraphIntegrityEngine ..> CryptoService : <<use>>
CustodyLog ..> CryptoService : <<use>>
EvidenceRiskScorer ..> EvidenceItem : <<use>>
EvidenceStateMachine ..> EvidenceItem : <<use>>
EvidenceStateMachine ..> EvidenceRiskScorer : <<use>>

note right of GraphIntegrityEngine
  The three <<engine>> classes and the <<service>>
  class hold BEHAVIOR and have no persistent state.
  None of them has any counterpart in the data model
  of the next figure, which is the clearest single
  difference between the two models.

  Case, EvidenceItem, CustodyLog and AuditRecord
  carry no operations: in this design they are data
  holders, and the behavior that acts on them lives
  in the engines.
end note
@enduml
